NINJA_RENDER_DOMAIN=
# Configurar como segredo na hospedagem. Não publicar um token real no código.
NINJA_RENDER_TOKEN=SUBSTITUIR_POR_SEGREDO_ALEATORIO_DE_PELO_MENOS_32_BYTES
PORT=8080
# Local: manter loopback. A imagem Docker configura 0.0.0.0 internamente.
HOST=127.0.0.1
# Opcional para desenvolvimento: pasta absoluta de v5 e dependências já instaladas
# NINJA_PACKAGE_ROOT=/caminho/distribuicao/ninja-ds-v5-rc2/v5
# NINJA_NODE_MODULES=/caminho/runtime/node_modules
# NINJA_BROWSER_PATH=/caminho/Chrome
# Ponte MCP stdio para clientes que a suportam; não é necessária no servidor
# NINJA_RENDER_URL=https://servidor-escolhido
