{
  "schema": "ninja-design-system/v5/chapeu",
  "version": "5.0.0-rc.1",
  "universal": {
    "opticalVerticalCentering": true,
    "tolerancePx": 1,
    "virtualArea": true,
    "recalculationTriggers": [
      "content",
      "font-loaded",
      "font-size",
      "line-break",
      "container-size"
    ]
  },
  "templates": {
    "ninja": {
      "treatment": "caixa-branca-retangular",
      "center": "optical",
      "borderRadiusPx": 0
    },
    "ninja-reels": {
      "treatment": "caixa-branca-retangular-centralizada",
      "center": "optical",
      "borderRadiusPx": 0
    },
    "foda": {
      "treatment": "faixa-amarela",
      "center": "optical"
    },
    "foda-reels": {
      "treatment": "faixa-amarela",
      "center": "optical"
    },
    "estudantes": {
      "treatment": "faixa-magenta",
      "center": "optical"
    },
    "estudantes-reels": {
      "treatment": "faixa-magenta",
      "center": "optical"
    },
    "cine-ninja": {
      "treatment": "box-branco",
      "center": "optical"
    },
    "ella": {
      "treatment": "sem-box-visivel",
      "center": "optical",
      "hierarchy": "maior-que-chamada"
    },
    "som": {
      "treatment": "pill-branca",
      "center": "optical"
    },
    "casa-ninja-amazonia": {
      "treatment": "pill-vermelha",
      "center": "optical"
    },
    "climax": {
      "treatment": "faixa-colorida-com-mascara-de-barras-vetoriais",
      "center": "optical",
      "preserveOrnament": true
    },
    "minas-ninja": {
      "treatment": "retangulo-verde",
      "center": "optical"
    }
  }
}
